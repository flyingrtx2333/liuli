{
  "version": 2,
  "width": 900,
  "height": 700,
  "root": {
    "kind": "column",
    "basis": [
      0,
      0
    ],
    "grow": 1,
    "padding": 32,
    "gap": 16,
    "stack_below": 0,
    "children": [
      {
        "kind": "text",
        "id": "title",
        "basis": [
          0,
          48
        ],
        "grow": 0,
        "text": "Explicit Tasks",
        "binding": ""
      },
      {
        "kind": "text",
        "id": "subtitle",
        "basis": [
          0,
          32
        ],
        "grow": 0,
        "text": "Compiled actions. Local state. No browser.",
        "binding": ""
      },
      {
        "kind": "search",
        "id": "draft",
        "basis": [
          0,
          52
        ],
        "grow": 0,
        "text": "Type a task...",
        "state": "draft"
      },
      {
        "kind": "row",
        "basis": [
          0,
          52
        ],
        "grow": 0,
        "padding": 0,
        "gap": 12,
        "stack_below": 0,
        "children": [
          {
            "kind": "button",
            "id": "add",
            "basis": [
              0,
              52
            ],
            "grow": 1,
            "text": "Add task",
            "action": "add_task"
          },
          {
            "kind": "button",
            "id": "remove",
            "basis": [
              0,
              52
            ],
            "grow": 1,
            "text": "Remove first",
            "action": "remove_task"
          }
        ]
      },
      {
        "kind": "list",
        "id": "tasks",
        "basis": [
          0,
          160
        ],
        "grow": 1,
        "binding": "tasks",
        "state": "offset",
        "delta": 3
      },
      {
        "kind": "text",
        "id": "footer",
        "basis": [
          0,
          28
        ],
        "grow": 0,
        "text": "Tab: focus   Enter: activate   Wheel: scroll",
        "binding": ""
      }
    ]
  }
}
